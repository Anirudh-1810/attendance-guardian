// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  name            String?
  password        String?      // Nullable for Google-only users
  role            String       @default("student") // "student" or "admin"
  googleId        String?      @unique             // Google OAuth sub ID
  avatar          String?                           // Profile picture URL
  createdAt       DateTime     @default(now())
  semesters       Semester[]
  createdInvites  InviteCode[] @relation("CreatedInvites")
  redeemedInvite  InviteCode?  @relation("RedeemedInvite")
}

model OTP {
  id        String   @id @default(uuid())
  email     String   @unique
  otpHash   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model InviteCode {
  id            String    @id @default(uuid())
  codeHash      String    @unique          // SHA-256 hash — never store plain invite codes
  createdById   String
  redeemedById  String?   @unique          // Prevents concurrent duplicate redemption at DB level
  used          Boolean   @default(false)
  revoked       Boolean   @default(false)
  expiresAt     DateTime?
  redeemedAt    DateTime?
  createdAt     DateTime  @default(now())

  createdBy     User      @relation("CreatedInvites", fields: [createdById], references: [id])
  redeemedBy    User?     @relation("RedeemedInvite", fields: [redeemedById], references: [id])

  @@index([createdById])
}

model Semester {
  id                 String       @id @default(uuid())
  name               String
  startDate          DateTime
  endDate            DateTime
  requiredPercentage Int          @default(75)
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  subjects           UserCourse[]
  holidays           Holiday[]
  
  // New fields for onboarding
  workingDays        String       @default("[]") // JSON string of days [1,2,3,4,5]
  timetable          TimeTable[]

  @@index([userId])
}

model TimeTable {
  id        String   @id @default(uuid())
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subjectId  String?  // Nullable for "Free" slots or unassigned
  subject    UserCourse? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0=Sun, 1=Mon, ..., 6=Sat
  slot       Int      // 1 to 7 (or more)
  startTime  String?  // Optional "09:00"
  endTime    String?  // Optional "10:00"

  @@index([semesterId])
  @@index([subjectId])
}

model UserCourse {
  id                    String   @id @default(uuid())
  semesterId            String
  semester              Semester @relation(fields: [semesterId], references: [id])
  courseCode            String
  courseName            String
  teacher               String?
  totalClassesConducted Int      @default(0)
  totalClassesAttended  Int      @default(0)
  classesPerWeek        Int
  requiredPercentage    Int      @default(75)
  maxAllowedAbsences    Int
  medicalLeavesAllowed  Int      @default(0)
  dutyLeavesAllowed     Int      @default(0)
  createdAt             DateTime @default(now())
  classes               Class[]
  timetable             TimeTable[]

  @@index([semesterId])
}

model Class {
  id        String     @id @default(uuid())
  subjectId String
  subject   UserCourse @relation(fields: [subjectId], references: [id])
  date      DateTime
  dayOfWeek Int?
  startTime String?
  endTime   String?
  status    String     @default("SCHEDULED")
  weightage Int        @default(1)
  notes     String?

  @@index([subjectId])
  @@index([date])
  @@index([subjectId, date])
  @@index([status])
  @@unique([subjectId, date])
}

model Holiday {
  id         String   @id @default(uuid())
  date       DateTime
  name       String
  type       String   @default("HOLIDAY")
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  @@index([semesterId])
}

